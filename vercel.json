{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{migrations/**,public/**,index.html}",
      "maxDuration": 15
    }
  },
  "redirects": [
    { "source": "/", "destination": "/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/kds", "destination": "/kds.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/counter-tv", "destination": "/counter-tv.html" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/track/(.*)", "destination": "/track.html" },
    { "source": "/conflicts", "destination": "/conflict-resolution.html" },
    { "source": "/table/(.*)", "destination": "/qr-order.html" }
  ]
}
